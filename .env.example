# App
APP_NAME="Rust React Boilerplate"
APP_URL="http://localhost:3000"
# Public web origin used in verification and reset links.
WEB_URL="http://localhost:5173"
APP_LOCALE="id"
# Generate with: openssl rand -hex 32
APP_SECRET="replace-with-at-least-32-characters"
APP_TIME_ZONE="Asia/Jakarta"
PORT=3000
WEB_DIST="web/dist"
COOKIE_SECURE=false
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
RATE_LIMIT=true
RUN_MIGRATIONS=true

# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/rust_boilerplate"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/rust_boilerplate_test"

# Mail (Mailpit in development)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="hello@example.com"

# Frontend
VITE_APP_NAME="Rust React Boilerplate"

# Logging
RUST_LOG="info,api=debug,rust_react_boilerplate_api=debug"
